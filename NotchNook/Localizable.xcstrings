    "Prevent from closing on mouse leave" : {

    },
    "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイドル時にNotchNookが隠れるのを防ぎます。画面録画に便利です（ノッチのない画面には影響しません）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止 NotchNook 在闲置时隐藏。对于屏幕录像很有用（对于没有凹槽的屏幕没有影响）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止 NotchNook 在閒置時隱藏。對於屏幕錄像很有用（對於沒有凹槽的屏幕沒有影響）。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止 NotchNook 在閒置時隱藏。對於屏幕錄像很有用（對於沒有凹槽的屏幕沒有影響）。"
          }
        }
      }
    },
