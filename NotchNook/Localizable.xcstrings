    "A beautiful and native Reddit client app for iOS." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "美しくネイティブなRedditクライアントアプリ（iOS用）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "个美观且原生的Reddit客户端应用程序，适用于iOS"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個美觀且原生的Reddit客戶端應用程式，適用於iOS"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個美觀同原生嘅Reddit客戶端應用程式，適用於iOS"
