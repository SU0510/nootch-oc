    "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabraňuje skrytí aplikace NotchNook v nečinnosti. Užitečné pro nahrávání obrazovky (nemá vliv na obrazovky bez výřezu)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindert das Verstecken von NotchNook im Hintergrund. Nützlich für Bildschirmaufnahmen (dies hat keinen Effekt auf nicht notched Bildschirmen)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previene que NotchNook se oculte cuando está inactivo. Útil para grabaciones de pantalla (esto no tiene efecto en pantallas sin notch)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêche NotchNook de disparaître lorsqu'il est inactif. Utile pour les enregistrements d'écran (cela n'a aucun effet sur les écrans sans encoche)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedisce a NotchNook di nascondersi quando è inattivo. Utile per le registrazioni dello schermo (questo non ha effetto sugli schermi senza notch)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイドル時にNotchNookが隠れるのを防ぎます。画面録画に便利です（ノッチのないディスプレイには影響しません）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유휴 상태일 때 NotchNook이 숨겨지는 것을 방지합니다. 화면 녹화 시에 유용합니다. (노치가 없는 화면에서는 효과가 없습니다)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindrer NotchNook fra å skjule seg når den ikke er stille. Nyttig for skjermopptak (dette har ingen effekt på ikke-notched skjermer)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapobiega ukrywaniu NotchNook w stanie bezczynności. Przydatne do nagrywania ekranu (nie ma to wpływu na ekrany bez notcha)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предотвращает скрытие NotchNook в бездействии. Полезно для записи экрана (это не влияет на экраны без NotchNook)."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevents NotchNook from hiding when idle. Useful for screen recordings (this has no effect on non-notched screens)."
          }
