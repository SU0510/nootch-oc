          "stringUnit" : {
            "state" : "translated",
            "value" : "Запобігає хованню NotchNook під час простою. Корисно для запису екрана (це не впливає на екрани без вирізів)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngăn NotchNook tự ẩn khi không hoạt động. Cài đặt này hữu ích khi đang quay màn hình (không ảnh hưởng tới màn hình không có notch)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止 NotchNook 在闲置时隐藏。对于屏幕录像很有用（对于没有凹槽的屏幕没有影响）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止NotchNook 在閒置時隱藏，對於正在螢幕錄影時很有用 (而對沒有瀏海的螢幕沒有影響)"
          }
        }
      }
    },
