          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NotchNook tries it's best to guess you notch width, but sometimes it can be a bit off. Here you can fine tune it. It has to be exactly the same size of your notch."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchNook sẽ cố đoán chiều rộng của cái notch của bạn, nhưng đôi khi nó có thể bị lệch. Bạn có thể điều chỉnh nó ở đây. Nó phải là kích cỡ chính xác của cái notch của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchNook 会尽力猜测你的凹槽宽度，但有时可能会有些偏差。你可以在这里进行微调。它必须与你的凹槽大小完全一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchNook 會盡力猜測你的凹槽寬度，但有時可能會有些偏差。你可以在這裡進行微調。它必須與你的凹槽大小完全一致。"
          }
