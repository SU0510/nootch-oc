    "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravte dobu _(v sekundách)_, za kterou živé aktivity zmizí poté, co se stanou neaktivními (například když se pozastaví hudba)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie die Zeit _(in Sekunden)_ ein, bis die Live-Aktivitäten nach der Inaktivität verschwindet (wie wenn Musik pausiert)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el tiempo (en segundos) que las actividades en vivo tardan en desaparecer después de quedar inactivas (como cuando la música se detiene)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säädä aikaa _(sekunneissa)_, jonka jälkeen live-aktiviteetit katoavat, kun ne muuttuvat epäaktiivisiksi (esimerkiksi kun musiikki keskeytetään)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez le temps _(en secondes)_ qu'il faut aux activités en direct pour disparaître une fois qu'elles sont devenues inactives (comme lorsque la musique s'arrête)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificare il tempo _(in secondi)_ che le attività live impiegano per andare via dopo che diventano inattive (come quando la musica si ferma)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブアクティビティが非アクティブになった後に消えるまでの時間(秒)を調整します(音楽が一時停止したときなど)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 액티비티가 비활성 상태가 된 후 사라지기까지 걸리는 시간 _(초 단위)_ 을 조정하세요. (음악 일시정지 등)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de tijd _(in seconden)_ aan die live activiteiten nemen om weg te gaan nadat ze inactief zijn geworden (zoals wanneer muziek pauzeert)."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden _(i sekunder)_ som publiserte aktiviteter tar å slutte når de blir inaktive (som når musikkpauser)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj czas _(w sekundach)_, po którym aktywności na żywo znikają po tym, jak stają się nieaktywne (jak w przypadku wstrzymania muzyki)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o tempo _(em segundos)_ que as atividades ao vivo levam para desaparecer depois de se tornarem inativas (como quando a música é pausada)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте время (в секундах) до скрытия эфира активности после того, как он станет не активным (к примеру, после паузы музыкального трека)."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tweak the time _(in seconds)_ that live activities take to go away after they become inactive (like when music pauses)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı etkinliklerin etkisiz hale geldikten sonra (örneğin müzik durduğunda) kaybolmaları için geçen süreyi _(saniye cinsinden)_ ayarla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте час _(у секундах)_, який потрібен для припинення живої діяльності після того, як вона стає неактивною (наприклад, коли музика призупиняється)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuỳ chỉnh thời gian _(giây)_ mà live activities đợi để đóng sau khi ngừng hoạt động (ví dụ khi nhạc ngừng chơi)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整实时活动在变为非活动状态后消失的时间（以秒为单位）（例如音乐暂停时）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整即時動態在非活動狀態後隱藏的時間 (例如音樂暫停時)，以秒為單位。"
          }
        }
      }
