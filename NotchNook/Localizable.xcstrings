    "A group of talented friends from 4 different countries that develop amazing software together for nothing but passion." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4つの異なる国から集まった才能ある友人たちが、情熱だけで素晴らしいソフトウェアを一緒に開発しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自四个不同国家的一群才华横溢的朋友，因为热情而共同开发了惊人的软件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自四個不同國家嘅一群才華橫溢嘅朋友，因為熱情而共同開發咗驚人嘅軟件。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自四個不同國家嘅一群才華橫溢嘅朋友，因為熱情而共同開發咗驚人嘅軟件。"
          }
        }
