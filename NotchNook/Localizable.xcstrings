    "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "魅力的なインターフェースと素晴らしい触覚フィードバックで、今後のイベントを確認しましょう。イベントの編集などが近日公開予定..."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一个可爱的界面和奇妙的触觉反馈中检查你即将到来的事件。事件编辑和更多功能即将推出..."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一個可愛嘅界面同奇妙嘅觸覺反饋中檢查你即將到來嘅事件。事件編輯同更多功能即將推出..."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一個可愛嘅界面同奇妙嘅觸覺反饋中檢查你即將到來嘅事件。事件編輯同更多功能即將推出..."
          }
        }
      }
