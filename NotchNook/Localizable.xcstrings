          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabraňuje skrytí aplikace NotchNook v nečinnosti. Užitečné pro nahrávání obrazovky (nemá vliv na obrazovky bez výřezu)."
          }
        },
        "da" : {
          "stringUnit" : {
