# NotchNook release — secrets & config.
#
# Copy this file to `.env` (same folder) and fill in the real values.
# `.env` is gitignored; THIS file (.env.example) is safe to commit.
#
#   cp .env.example .env
#
# All values are loaded by lib.sh via `source`, so $HOME and other shell
# variables expand normally.

# ── Apple notarization (App Store Connect API key) ──────────────────────────
# From App Store Connect → Users and Access → Integrations → App Store Connect API.
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_ISSUER_ID=00000000-0000-0000-0000-000000000000
# The .p8 private key, base64-encoded into a single line:
#   base64 -i AuthKey_XXXX.p8 | tr -d '\n'
APPLE_API_KEY_P8_BASE64=
# Developer team id (Apple Developer → Membership).
APPLE_TEAM_ID=XXXXXXXXXX

# ── Code signing ────────────────────────────────────────────────────────────
# Leave as the literal "Developer ID Application" to auto-detect the installed
# identity, or pin an exact name / SHA-1 from `security find-identity -v -p codesigning`.
CODESIGN_IDENTITY="Developer ID Application"

# ── Sparkle (EdDSA update signing) ──────────────────────────────────────────
# The private key string from Sparkle's `generate_keys`. Used to sign the
# update zip + appcast. The public counterpart is baked into Info.plist.
SPARKLE_PRIVATE_KEY=
SPARKLE_PUBLIC_KEY=

# ── Paths ───────────────────────────────────────────────────────────────────
NOTCHNOOK_REPO=$HOME/Projects/NotchNook
LOCAFE_REPO=$HOME/Projects/lo-cafe
# Public URL prefix where the zips/deltas are served (used in the appcast).
APPCAST_DOWNLOAD_PREFIX=https://lo.cafe/notchnook-files/
